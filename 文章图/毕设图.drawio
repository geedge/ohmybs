        </mxCell>
        <mxCell id="AHdrAhRjbRmV95W1NLka-1" value="&lt;div style=&quot;text-align: justify; line-height: 200%;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;利用跨栈解析场景下IPv4-IPv6 DNS服务的合作解析机制，通过自建权威服务器进行动态域名水印植入，主动探测与被动收集分析相结合 ，实现对IPv6 DNS递归解析服务的挖掘&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-20" y="545" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="AHdrAhRjbRmV95W1NLka-2" value="&lt;div style=&quot;text-align: justify; line-height: 200%;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;将通过&lt;/font&gt;&lt;span style=&quot;background-color: initial; font-size: 20px;&quot;&gt;IPv6 DNS服务发现方法&lt;/span&gt;&lt;span style=&quot;font-size: 20px; background-color: initial;&quot;&gt;获得的IPv4-IPv6 DNS关联作为输入数据集，利用别名地址解析技术实现地址到主机关系的映射，通过主机关联识别IPv6 DNS服务中双栈部署方式的存在&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="460" y="550" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lhZ6lJxVZe9wpVcJl5ga-2" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="115" y="1035" width="475" height="80" as="geometry" />
        </mxCell>
        <mxCell id="AHdrAhRjbRmV95W1NLka-3" value="" style="rounded=1;whiteSpace=wrap;html=1;" parent="lhZ6lJxVZe9wpVcJl5ga-2" vertex="1">
          <mxGeometry width="475" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lhZ6lJxVZe9wpVcJl5ga-1" value="&lt;div style=&quot;text-align: justify; line-height: 200%;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;设计风险评估函数和指标，实现对不同部署方式的IPv6 DNS服务脆弱性的挖掘，发现潜在风险&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="lhZ6lJxVZe9wpVcJl5ga-2" vertex="1">
